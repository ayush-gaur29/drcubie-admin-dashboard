# Supabase Configuration for Dr. Cubie Admin Dashboard
# Use the same Supabase project as drcubie-app
# IMPORTANT: Only use the anon / publishable key. NEVER expose service_role key in frontend!

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
